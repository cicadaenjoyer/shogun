{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ConnectionStrings": { "Default": "Data Source=shogun.db" },
    "Hub": {
        "FunctionsBaseAddress": "https://us-central1-shogun-hub.cloudfunctions.net",
        "ServerPassIssuer": "https://shogun-hub.web.app",
        "JwksAddress": "https://shogun-hub.web.app/.well-known/jwks.json",
        "HeartbeatIntervalSeconds": 120
    },
    "Web": {
        "AllowedOrigins": [ "https://shogun-hub.web.app" ]
    },
    "Storage": {
        "DataFolder": "/var/lib/shogun",
        "ImageCacheFolder": "/var/cache/shogun/images",
        "TranscodeTempFolder": "/var/tmp/shogun/transcode"
    },
    "Transcoding": {
        "MaxSimultaneousTranscodes": 5
    },
    "AllowedHosts": "*"
}
