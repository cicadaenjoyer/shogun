{
    "Serilog": {
        "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
        "MinimumLevel": "Debug",
        "WriteTo": [
            { "Name": "Console" },
            { "Name": "File", "Args": { "path": "Logs/log.txt" } }
        ],
        "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
        "Destructure": [
            {
                "Name": "With",
                "Args": { "policy": "Sample.CustomPolicy, Sample" }
            },
            {
                "Name": "ToMaximumDepth",
                "Args": { "maximumDestructuringDepth": 4 }
            },
            {
                "Name": "ToMaximumStringLength",
                "Args": { "maximumStringLength": 100 }
            },
            {
                "Name": "ToMaximumCollectionCount",
                "Args": { "maximumCollectionCount": 10 }
            }
        ],
        "Properties": {
            "Application": "Sample"
        }
    },
    "ConnectionStrings": { "Default": "Data Source=shogun.db" },
    "Hub": {
        "FunctionsBaseAddress": "https://us-central1-shogun-hub.cloudfunctions.net",
        "ServerPassIssuer": "https://shogun-hub.web.app",
        "JwksAddress": "https://shogun-hub.web.app/.well-known/jwks.json",
        "HeartbeatIntervalSeconds": 120
    },
    "Web": {
        "AllowedOrigins": ["https://shogun-hub.web.app"]
    },
    "Storage": {
        "DataFolder": "/var/lib/shogun",
        "ImageCacheFolder": "/var/cache/shogun/images",
        "TranscodeTempFolder": "/var/tmp/shogun/transcode"
    },
    "Transcoding": {
        "MaxSimultaneousTranscodes": 5
    },
    "AllowedHosts": "*"
}
